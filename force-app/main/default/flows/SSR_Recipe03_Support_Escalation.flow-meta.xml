    <decisions>
        <description>Route le message Slack selon la priorité du case escaladé.</description>
        <name>Check_Priority</name>
        <label>Priorité du case</label>
        <locationX>314</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Send_Slack_Low</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Low (Default)</defaultConnectorLabel>
        <rules>
            <name>Priority_High</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Priority</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>High</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Slack_High</targetReference>
            </connector>
            <label>High</label>
        </rules>
