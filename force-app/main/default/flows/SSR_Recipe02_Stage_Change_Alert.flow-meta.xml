<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Envoie l&apos;alerte de changement de stage via SlackService (SSR Stack).</description>
        <name>Send_Slack_Message</name>
        <label>SSR Send Slack Message</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>SlackInvocable</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>message</name>
            <value>
                <elementReference>tt_SlackMessage</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipeKey</name>
            <value>
                <stringValue>recipe_02</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>SlackInvocable</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Recette 02 SSR — alerte Slack quand le StageName d&apos;une Opportunity change (via Bot API + CMDT).</description>
    <environments>Default</environments>
    <interviewLabel>SSR Recipe 02 - Alerte Changement Stage {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SSR Recipe 02 - Alerte Changement Stage</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GetOpportunityOwner</name>
        <label>Get Opportunity Owner</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Send_Slack_Message</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetOpportunityOwner</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>StageName</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <description>Message Slack pour transition de stage.</description>
        <name>tt_SlackMessage</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>*Opportunité mise à jour 📊*
*{!$Record.Name}*
Stage : ~{!$Record__Prior.StageName}~ → *{!$Record.StageName}*
*Montant :* {!$Record.Amount}€
*Commercial :* {!GetOpportunityOwner.Name}</text>
    </textTemplates>
</Flow>
